{
    "manifest_version": 3,
    "name": "Prayer Times Table",
    "version": "1.1.0",
    "description": "Prayer times with reliable notifications and a configurable city / calculation method.",
    "icons": {
        "16": "images/icon-16.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "permissions": [
        "storage",
        "notifications",
        "alarms"
    ],
    "host_permissions": [
        "https://api.aladhan.com/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "images/icon-48.png"
    },
    "options_page": "options/options.html"
}
